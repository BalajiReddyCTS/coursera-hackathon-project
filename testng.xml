<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng.xml - TestNG Suite Configuration

  PARALLEL EXECUTION:
  parallel="classes" means each test CLASS runs in its own thread.
  thread-count="3" means up to 3 browsers open simultaneously.

  Since TestRunner's @DataProvider(parallel=true) is set,
  individual SCENARIOS also run in parallel within the class.

  HOW PARALLEL WORKS HERE:
  1. Maven Surefire picks up testng.xml
  2. TestNG reads the <suite> and starts thread pool
  3. TestRunner.scenarios() feeds each Cucumber scenario as a data row
  4. Each data row = one scenario = one thread = one browser instance
-->
<suite name="CourseraAutomationSuite" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <!--
          TestNG listener (separate from Cucumber listener).
          We register it here so TestNG lifecycle events are also captured.
          (Optional — our main listener is the Cucumber CucurrentEventListener)
        -->
    </listeners>

    <test name="CourseraTests" preserve-order="true">
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

    <!--
      To run a SPECIFIC feature only, add another <test> block:

      <test name="CourseSearchOnly">
        <parameter name="cucumber.filter.tags" value="@CourseSearch"/>
        <classes>
          <class name="runners.TestRunner"/>
        </classes>
      </test>
    -->

</suite>
